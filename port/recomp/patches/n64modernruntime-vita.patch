+//---------------------------------------------------------
+// Semaphore (PS Vita native kernel primitive)
+//---------------------------------------------------------
+class Semaphore
+{
+private:
+	SceUID m_sema;
+
+	Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+	Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+public:
+	Semaphore(int initialCount = 0)
+	{
+		assert(initialCount >= 0);
+		m_sema = sceKernelCreateSema("N64ModernRuntime", 0,
+			static_cast<SceInt32>(initialCount), 0x7fffffff, nullptr);
+		assert(m_sema >= 0);
+	}
+
+	~Semaphore()
+	{
+		if (m_sema >= 0) sceKernelDeleteSema(m_sema);
+	}
+
+	bool wait()
+	{
+		return sceKernelWaitSema(m_sema, 1, nullptr) >= 0;
+	}
+
+	bool try_wait()
+	{
+		return sceKernelPollSema(m_sema, 1) >= 0;
+	}
+
+	bool timed_wait(std::uint64_t usecs)
+	{
+		SceUInt timeout = usecs > 0xffffffffULL ? 0xffffffffU
+			: static_cast<SceUInt>(usecs);
+		return sceKernelWaitSema(m_sema, 1, &timeout) >= 0;
+	}
+
+	void signal(int count = 1)
+	{
+		assert(count >= 0);
+		const int result = sceKernelSignalSema(m_sema, count);
+		assert(result >= 0);
+		(void)result;
+	}
+};
